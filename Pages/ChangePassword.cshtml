@page
@using StatiqMarkdownEditor.Auth
@model StatiqMarkdownEditor.Pages.ChangePasswordModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Change password";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<div class="auth-card auth-card--wide">
    <div class="auth-icon">🔑</div>
    <h1 class="auth-title">Change password</h1>

    @if (Model.AuthDisabled)
    {
        <p class="auth-lede">
            Authentication is <strong>disabled</strong> on this instance, so there
            is no password to change. To enable auth, set
            <code>Auth.Enabled=true</code> in <code>appsettings.json</code>, run
            <code>dotnet run -- --init-auth</code>, and restart.
        </p>
    }
    else
    {
        <p class="auth-lede">
            After changing it, you'll need to use the new password to sign back in.
            Other devices with the old session will be signed out automatically.
        </p>
        <form id="change-pw-form" method="post" action="/api/auth/change-password" autocomplete="on">
            <input type="hidden" name="_csrf" value="@Model.CsrfToken" />

            <div class="auth-field">
                <label for="current" class="auth-label">Current password</label>
                <input type="password" id="current" name="currentPassword"
                       class="auth-input" required autocomplete="current-password" />
            </div>

            <div class="auth-field">
                <label for="new" class="auth-label">New password</label>
                <input type="password" id="new" name="newPassword"
                       class="auth-input" required minlength="8" autocomplete="new-password" />
                <div class="auth-hint">At least 8 characters. Must differ from the current one.</div>
            </div>

            <div class="auth-field">
                <label for="confirm" class="auth-label">Confirm new password</label>
                <input type="password" id="confirm" name="confirmPassword"
                       class="auth-input" required minlength="8" autocomplete="new-password" />
            </div>

            <div id="pw-error" class="auth-error" hidden></div>

            <div class="auth-actions">
                <a href="/" class="auth-btn auth-btn--ghost">Cancel</a>
                <button type="submit" class="auth-btn auth-btn--primary">Change password</button>
            </div>
        </form>
    }
</div>

<script>
    (function () {
        var form = document.getElementById('change-pw-form');
        if (!form) return;
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var errEl = document.getElementById('pw-error');
            errEl.hidden = true;
            errEl.textContent = '';

            var newPw = document.getElementById('new').value;
            var confirm = document.getElementById('confirm').value;
            if (newPw !== confirm) {
                errEl.textContent = 'new password and confirmation do not match';
                errEl.hidden = false;
                document.getElementById('confirm').focus();
                return;
            }

            var json = JSON.stringify({
                currentPassword: document.getElementById('current').value,
                newPassword: newPw,
                csrf: document.querySelector('input[name="_csrf"]').value,
            });

            // Disable the button + show pending state.
            var btn = form.querySelector('button[type="submit"]');
            var original = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Changing…';

            fetch(form.action, {
                method: 'POST',
                body: json,
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
            }).then(function (r) {
                if (r.ok) {
                    btn.textContent = '✓ Done — redirecting…';
                    // Clear local cookies client-side and bounce to /Login
                    document.cookie = 'statiq_editor_session=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
                    document.cookie = 'statiq_editor_csrf=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
                    setTimeout(function () { window.location.href = '/Login?passwordChanged=1'; }, 400);
                    return;
                }
                return r.json().then(function (j) { throw new Error(j.error || 'Change failed'); });
            }).catch(function (err) {
                errEl.textContent = err.message || 'Change failed';
                errEl.hidden = false;
                btn.disabled = false;
                btn.textContent = original;
            });
        });
    })();
</script>