@page
@model StatiqMarkdownEditor.Pages.SettingsModel
@{
    ViewData["Title"] = "Settings — Statiq MD Editor";
}
@section Styles {
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
}

<section class="settings-page">
    <h1>Settings</h1>
    <p class="muted">
        Each site lives in its own folder under <code>sites/&lt;name&gt;/</code> with a
        <code>config.json</code> describing the theme, host, analytics IDs, and so on.
        Sites are auto-discovered — to add a new one, drop a new folder under
        <code>sites/</code> and reload this page.
    </p>

    <h2 class="section-title">Active site</h2>
    <p class="muted">
        The editor reads posts and images from the active site's
        <code>input/posts/</code> and <code>input/images/</code>. Pick one below.
        The choice is persisted to <code>appsettings.json</code> (or its env-specific
        override).
    </p>

    <div id="sites-list" class="sites-list">
        <p class="muted" id="sites-loading">Loading sites…</p>
    </div>

    <details class="settings-help">
        <summary>How it works</summary>
        <ul>
            <li>Sites are discovered from <code>sites/&lt;name&gt;/config.json</code>. The directory name is the site slug.</li>
            <li>Per-site settings (theme, host, Umami/GA IDs, content layout toggles) live in each <code>config.json</code>. To edit them, open the file directly.</li>
            <li>The active site is the single mutable state. Click <strong>Activate</strong> on a card to switch.</li>
            <li>Frontmatter is parsed and re-emitted with a stable key order (Title, Description, Date, Layout, Image, Category, Draft, Tags) so diffs stay clean.</li>
            <li>Watermarks + image uploads are scoped to the active site. Theme pages live in <code>themes/&lt;name&gt;/</code> or <code>themes/&lt;name&gt;/input/</code> — each site renders against its own theme.</li>
        </ul>
    </details>
</section>

@section Scripts {
    <script src="~/js/settings.js" asp-append-version="true"></script>
}