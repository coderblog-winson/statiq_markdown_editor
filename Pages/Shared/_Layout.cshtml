@{
    var currentPath = Context.Request.Path.Value ?? "/";
    var isEditor = currentPath.StartsWith("/editor", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Statiq Markdown Editor")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=JetBrains+Mono:wght@400;500&display=swap" />
    @RenderSection("Styles", required: false)
</head>
<body class="@(isEditor ? "editor-page" : "list-page")">
    <header class="app-header">
        <div class="brand">
            <a href="/" class="brand-link">
                <span class="brand-mark">⌘</span>
                <span class="brand-name">Statiq MD Editor</span>
            </a>
        </div>
        <nav class="header-nav">
            <a href="/" class="nav-link @(currentPath == "/" ? "active" : "")">Posts</a>
            <a href="/New" class="nav-link @(currentPath.StartsWith("/New", StringComparison.OrdinalIgnoreCase) ? "active" : "")">New</a>
            <a href="/Settings" class="nav-link @(currentPath.StartsWith("/Settings", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Settings</a>
        </nav>
        <div class="header-right">
            <a href="/api/posts" target="_blank" class="nav-link subtle" title="Open API as JSON">API</a>
            <span class="nav-site-wrap">
                <button type="button" class="nav-site" id="site-menu-btn"
                        title="Active site — click to switch">
                    <span id="site-label">(no site)</span>
                </button>
                <div class="nav-site-menu" id="site-menu" hidden></div>
            </span>
            <button type="button" class="nav-link nav-action" id="build-btn"
                    title="Build the active site in-process (Statiq.Web Bootstrapper) — fast feedback, no script spawn"
                    aria-label="Build">
                <span aria-hidden="true">🛠</span> Build
            </button>
            <button type="button" class="nav-link nav-action" id="preview-btn"
                    title="Run preview.sh — build + start local HTTP server on the configured port"
                    aria-label="Preview">
                <span aria-hidden="true">▶</span> Preview
            </button>
            <button type="button" class="nav-link nav-action" id="deploy-btn"
                    title="Run build_deploy.sh — build + rsync to VPS + git-sync"
                    aria-label="Deploy">
                <span aria-hidden="true">↑</span> Deploy
            </button>
            <button type="button" class="nav-link nav-action" id="gitsync-btn"
                    title="Run git_sync.sh — commit + push current changes to origin"
                    aria-label="Git Sync">
                <span aria-hidden="true">⇆</span> Git Sync
            </button>
        </div>
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    <div id="toast-host" class="toast-host" aria-live="polite"></div>

    <!-- Shared modal for Build / Preview / Deploy / Git Sync.
         site-builder.js wires up the buttons and streams status/log
         here. Lives in the layout so every page can drive it. -->
    <div class="modal" id="script-modal" hidden>
        <div class="modal-backdrop" data-script-close></div>
        <div class="modal-panel script-panel">
            <header class="modal-header">
                <h2 id="script-modal-title">Build</h2>
                <span id="script-modal-status" class="script-status status-idle">idle</span>
                <button type="button" class="modal-close" data-script-close aria-label="Close">×</button>
            </header>
            <div class="modal-body script-body">
                <pre id="script-log" class="script-log" aria-live="polite"></pre>
            </div>
            <footer class="modal-footer">
                <a id="script-open-link" href="#" target="_blank" rel="noopener" class="btn btn-ghost" hidden>Open output ↗</a>
                <button type="button" class="btn btn-ghost" id="script-stop-btn" hidden>Stop preview</button>
                <span class="spacer"></span>
                <button type="button" class="btn btn-ghost" data-script-close>Close</button>
            </footer>
        </div>
    </div>

    <!-- site-builder wires up the site dropdown + Preview/Deploy buttons +
         build modal. Loaded in every page (via the layout) so it works
         site-wide. -->
    <script src="~/js/site-builder.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>