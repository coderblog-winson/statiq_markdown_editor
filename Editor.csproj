<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StatiqMarkdownEditor</RootNamespace>
    <AssemblyName>StatiqMarkdownEditor</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- themes/ and sites/ hold Razor templates + content for the embedded
         Statiq.Web engine. Don't compile them with the editor's Razor view
         engine (they use Statiq's IDocument API, not the editor's).
         Pages/ + wwwroot/ are the editor's own Razor Pages — those DO need
         compile-time Razor compilation, so they stay enabled.
         DefaultItemExcludes skips themes/sites/dist from the default include
         glob. dist/ is the staging output of `npm run package:mac` — its
         themes/ and sites/ subdirectories hold *real* .cshtml/.md content
         that Statiq will load at runtime, but the editor's Razor compiler
         must NOT touch them or it fails with "ContentType is a type but is
         used like a variable" / "Response/Documents does not exist".
         Note: paths use FORWARD slashes — backslashes are Windows-only and
         silently fail on macOS/Linux. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);themes/**;sites/**;dist/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Statiq.Web" Version="1.0.0-beta.60" />
    <PackageReference Include="YamlDotNet" Version="15.1.6" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.5" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.4" />
  </ItemGroup>

  <!-- Exclude themes/, sites/ and dist/ from Razor compilation (Statiq's
       templates use IDocument, not the editor's Razor view model) but keep
       themes/ and sites/ as runtime content so the editor's embedded
       Bootstrapper can find them. dist/ is purely a packaging staging
       directory and never goes into the source.
       Paths use forward slashes — backslashes silently no-op on macOS/Linux. -->
  <ItemGroup>
    <RazorPage Remove="themes/**" />
    <RazorPage Remove="sites/**" />
    <RazorPage Remove="dist/**" />
    <None Include="themes/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="sites/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>