@*
  _Layout.cshtml — demo site master layout.
  Minimal but real: pulls in a sidebar partial, renders body content,
  shows the site Host in <title> (proves setting injection works).
*@
@{
    Layout = null;
    var title = (string)(Document?.GetString("Title") ?? "Demo");
    var host = Context.Settings.GetString("Host") ?? "demo.local";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title — @host</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header>
        <h1><a href="/">@host</a></h1>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer>
        <small>Generated by Statiq Markdown Editor · @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") UTC</small>
    </footer>
</body>
</html>