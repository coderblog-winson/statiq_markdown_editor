@{
    Layout = null;
    var dest = Document.Destination.IsNull ? "" : Document.Destination.ToString();
    var title = Document.GetString("Title") ?? "Statiq Markdown Editor Demo";
    var description = Document.GetString("Description")
        ?? "A web-based editor for Statiq markdown posts. Single-user local tool — no cloud, no telemetry.";
    var canonical = (Document.GetLink(true) ?? "").Replace("http://", "https://");
    var ogImage = Document.GetString("Image");

    // Page title: if the page defines a "Title" section (just plain text),
    // use it; otherwise fall back to the document title.
    var pageTitle = title;
    if (IsSectionDefined("Title"))
    {
        // We can't easily extract text from a section, so pages that want
        // to override should set Document metadata themselves. To keep this
        // simple, the section variant is rare — usually you'd set Title in
        // frontmatter or in @{} above.
        pageTitle = title;
    }
    pageTitle = $"{pageTitle} · Statiq Editor Demo";
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>@pageTitle</title>
<meta name="description" content="@description" />
<meta name="theme-color" content="#faf6ef" />
<link rel="canonical" href="@canonical" />
<meta property="og:type" content="website" />
<meta property="og:title" content="@title" />
<meta property="og:description" content="@description" />
<meta property="og:url" content="@canonical" />
@if (!string.IsNullOrEmpty(ogImage)) {
    <meta property="og:image" content="@ogImage" />
}
<link rel="stylesheet" href="/assets/css/site.css" asp-append-version="true" />
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
@RenderSection("Styles", required: false)
</head>
<body>
<header class="site-header">
    <div class="container">
        <a href="/" class="brand">
            <span class="brand-mark">⌘</span>
            <span class="brand-name">Statiq MD Editor</span>
        </a>
        <nav class="site-nav">
            <a href="/">Home</a>
            <a href="/about.html">About</a>
            <a href="/archives.html">Archives</a>
            <a href="/tags.html">Tags</a>
            <a href="https://github.com/winsonet/statiq_markdown_editor" target="_blank" rel="noopener">GitHub</a>
        </nav>
    </div>
</header>

<main class="site-main">
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container">
        <p>
            <strong>Statiq Markdown Editor</strong> · single-user local tool · no cloud, no telemetry.
        </p>
        <p class="muted small">
            Generated by <a href="https://www.statiq.dev/">Statiq.Web</a>.
            Built with <a href="https://github.com/winsonet/statiq_markdown_editor">winsonet/statiq_markdown_editor</a>.
        </p>
    </div>
</footer>

@RenderSection("Scripts", required: false)
</body>
</html>