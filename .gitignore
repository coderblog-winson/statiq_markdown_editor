bin/
obj/
*.user
.vs/
.idea/
.DS_Store
*.log

# Per-developer overrides. The committed appsettings.json is an empty
# skeleton so `dotnet run` works for anyone who clones; real local paths
# go in appsettings.Development.json (auto-loaded when ASPNETCORE_ENVIRONMENT=Development,
# which is the default for `dotnet run` / `dotnet watch`).
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json

# Electron + npm
node_modules/
dist/
*.dmg

# Per-site private content — each site lives in its own GitHub repo
# (winsonet/coderblog.statiq, winsonet/winsoninvest.statiq,
#  winsonet/tableware.statiq.site). Pushing them into the editor's
# public repo would leak the markdown + images. The _demo/ site is
# allowed in — it's the editor's own demo content.
#
# Per-site themes (Sep-2026) live UNDER each site at
# sites/<name>/themes/, so they're caught by sites/* above too.
# The only thing that stays public in themes/ is _demo.
sites/*
!sites/_demo/
!sites/README.md

themes/_demo/

# WatermarkTool batch working dirs — input = source images, output =
# watermarked result. Never commit; they're the user's private assets
# (and regenerated every time the cron runs, if any).
WatermarkTool/input/
WatermarkTool/output/
WatermarkTool/org_images/

# Generated artefacts
cache/
output/

# Auth/auth.json holds the bcrypt/PBKDF2 password hash. Never commit.
# Generated by `dotnet run --init-auth` and lives at the editor root,
# OUTSIDE wwwroot/ so the web server does NOT serve it.
Auth/auth.json

